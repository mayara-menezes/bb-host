# Copy this file to .env and adjust the values.
# For local development DJANGO_DEBUG=True is enough; in production DJANGO_SECRET_KEY is required.

DJANGO_DEBUG=True
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted origins for CSRF in production, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Turns the Django Debug Toolbar off even when DEBUG is on
DJANGO_DEBUG_TOOLBAR=True
